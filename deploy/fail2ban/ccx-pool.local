# conceal-guardian-pool fail2ban jail sample.
# Install as /etc/fail2ban/jail.d/ccx-pool.local (or merge into jail.local).
#
# Placeholders - replace before enabling:
#   <VPS_IP>            this server's own public IP address
#   <apache2_proxy_IP>  the reverse proxy in front of the pool. The pool runs as
#                       user `conceal` behind apache2 (single proxy hop) and sets
#                       `trust proxy 1`, so fail2ban sees the real client IP.
#   <operator_IP>       your own static address so you cannot lock yourself out
#
# Validate the filter against the real log BEFORE enabling this jail; expect
# matched=82 on the current log:
#   fail2ban-regex /home/conceal/.local/share/ccxNodePool/errors.log /etc/fail2ban/filter.d/ccx-pool.conf

[ccx-pool]
enabled = true
filter = ccx-pool
logpath = /home/conceal/.local/share/ccxNodePool/errors.log
backend = auto
maxretry = 2
findtime = 10m
bantime = 1d
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 6mo
ignoreip = 127.0.0.1/8 ::1 <VPS_IP> <apache2_proxy_IP> <operator_IP>
